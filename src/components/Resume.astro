---
import { profile, about, experience, skills, projects } from '../data/cv';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<article class="print-container mx-auto max-w-3xl px-6 py-10 text-slate-300">
  <header class="border-b border-white/10 pb-4">
    <h1 class="font-display text-3xl font-bold tracking-tight text-white">{profile.name}</h1>
    <p class="mt-1 font-display text-lg font-medium text-brand-300">{profile.role[lang]}</p>
    <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-sm text-slate-400">
      <span>{profile.location[lang]}</span>
      <span aria-hidden="true">·</span>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <span aria-hidden="true">·</span>
      <a href={profile.social.github}>{profile.social.github.replace('https://', '')}</a>
      <span aria-hidden="true">·</span>
      <a href={profile.social.linkedin}>{profile.social.linkedin.replace('https://www.', '').replace('https://', '')}</a>
    </p>
  </header>

  <p class="mt-4 text-sm leading-relaxed text-slate-300">{about.summary[lang]}</p>

  <section class="mt-6">
    <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-brand-300">
      {lang === 'id' ? 'Pengalaman' : 'Experience'}
    </h2>
    <div class="mt-3 space-y-4">
      {
        experience.map((job) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <h3 class="font-semibold text-white">{job.role[lang]} · {job.company}</h3>
              <span class="font-mono text-sm text-slate-400">{job.period[lang]}</span>
            </div>
            <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-slate-300">
              {job.highlights.map((h) => (
                <li>{h[lang]}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-6">
    <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-brand-300">
      {lang === 'id' ? 'Keahlian' : 'Skills'}
    </h2>
    <ul class="mt-3 space-y-1 text-sm text-slate-300">
      {
        skills.map((group) => (
          <li>
            <span class="font-semibold text-white">{group.title[lang]}:</span>{' '}
            {group.items.join(', ')}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-6">
    <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-brand-300">
      {lang === 'id' ? 'Proyek' : 'Projects'}
    </h2>
    <div class="mt-3 space-y-3">
      {
        projects.map((project) => (
          <div>
            <h3 class="font-semibold text-white">{project.name}</h3>
            <p class="text-sm text-slate-300">{project.description[lang]}</p>
            <p class="font-mono text-xs text-slate-400">{project.tech.join(' · ')}</p>
          </div>
        ))
      }
    </div>
  </section>
</article>
