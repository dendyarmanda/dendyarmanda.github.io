---
import { profile } from '../data/cv';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
  cvHref: string;
}
const { lang, cvHref } = Astro.props;
const t = useTranslations(lang);

// Real, true-by-construction domain tags (NOT invented metrics).
const tags = ['Core Banking', 'ISO 8583', 'Payment Switching', 'PCI-DSS'];
---

<section id="top" class="relative isolate overflow-hidden">
  <!-- Aurora backdrop -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="aurora-blob absolute -top-32 -left-24 h-[28rem] w-[28rem] rounded-full bg-brand-500/25 blur-[120px]"
    >
    </div>
    <div
      class="aurora-blob-2 absolute -top-20 right-0 h-[26rem] w-[26rem] rounded-full bg-brand-300/20 blur-[120px]"
    >
    </div>
    <div
      class="aurora-blob absolute top-40 left-1/3 h-[22rem] w-[22rem] rounded-full bg-indigo-500/15 blur-[120px]"
    >
    </div>
    <div class="grid-mesh absolute inset-0"></div>
  </div>

  <div class="mx-auto max-w-5xl px-4 pt-20 pb-16 md:pt-32 md:pb-24">
    <p
      class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 font-mono text-xs font-medium tracking-wide text-brand-200 backdrop-blur"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-400"></span>
      </span>
      {profile.role[lang]}
    </p>

    <h1
      class="font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl"
    >
      <span class="text-gradient">{profile.name}</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
      {profile.tagline[lang]}
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a
        href={cvHref}
        class="group inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-brand-500 to-brand-300 px-5 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-brand-500/25 transition hover:shadow-brand-400/40 hover:brightness-110"
      >
        {t('hero.cta.cv')}
        <svg class="h-4 w-4 transition group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
      <a
        href="#contact"
        class="glass glass-hover rounded-xl px-5 py-3 text-sm font-semibold text-white"
      >
        {t('hero.cta.contact')}
      </a>

      <div class="flex items-center gap-1 pl-2">
        <a href={profile.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="rounded-lg p-2 text-slate-400 transition hover:bg-white/5 hover:text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.42.36.79 1.08.79 2.18v3.23c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
        </a>
        <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="rounded-lg p-2 text-slate-400 transition hover:bg-white/5 hover:text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
        <a href={`mailto:${profile.email}`} aria-label="Email" class="rounded-lg p-2 text-slate-400 transition hover:bg-white/5 hover:text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Domain tags (real, not invented metrics) -->
    <div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {
        tags.map((tag) => (
          <div class="glass rounded-xl px-4 py-3 text-center">
            <span class="font-mono text-sm font-medium text-slate-200">{tag}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
