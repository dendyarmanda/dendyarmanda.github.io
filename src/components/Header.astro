---
import { useTranslations, languages } from '../i18n/ui';
import type { Locale } from '../data/cv';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const otherLang: Locale = lang === 'id' ? 'en' : 'id';

const nav = [
  { href: '#about', label: t('nav.about') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header
  class="no-print sticky top-0 z-50 border-b border-slate-200/70 bg-slate-50/80 backdrop-blur dark:border-slate-800/70 dark:bg-slate-950/80"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="#top" class="font-bold tracking-tight text-slate-900 dark:text-white">DSA</a>

    <ul class="hidden gap-6 text-sm font-medium md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              class="text-slate-600 transition hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-400"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={altHref}
        class="rounded-md border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-700 transition hover:border-brand-500 hover:text-brand-600 dark:border-slate-700 dark:text-slate-200 dark:hover:text-brand-400"
        aria-label={`Switch language to ${otherLang.toUpperCase()}`}
      >
        {languages[otherLang]}
      </a>
      <ThemeToggle label={t('theme.toggle')} />
    </div>
  </nav>
</header>
