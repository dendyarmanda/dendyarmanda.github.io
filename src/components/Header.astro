---
import { useTranslations, languages } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const otherLang: Locale = lang === 'id' ? 'en' : 'id';

const nav = [
  { href: '#about', label: t('nav.about') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="no-print sticky top-0 z-50 border-b border-white/5 bg-ink/70 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3.5">
    <a
      href="#top"
      class="font-display text-base font-bold tracking-tight text-white transition hover:text-brand-300"
    >
      <span class="text-gradient">DSA</span>
    </a>

    <ul class="hidden gap-7 text-sm font-medium md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              class="text-slate-400 transition-colors hover:text-white"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={altHref}
      class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 font-mono text-xs font-semibold text-slate-300 transition hover:border-brand-400/50 hover:text-white"
      aria-label={`Switch language to ${otherLang.toUpperCase()}`}
    >
      {languages[lang]} <span class="text-slate-600">/</span> {languages[otherLang]}
    </a>
  </nav>
</header>
