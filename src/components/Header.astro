---
import { useTranslations, languages } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const otherLang: Locale = lang === 'id' ? 'en' : 'id';

const nav = [
  { href: '#about', label: t('nav.about') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="no-print sticky top-0 z-50 border-b border-white/5 bg-ink/70 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3.5">
    <a href="#top" class="font-display text-base font-bold tracking-tight">
      <span class="text-gradient">DSA</span>
    </a>

    <ul class="hidden gap-7 text-sm font-medium md:flex">
      {
        nav.map((item) => (
          <li>
            <a class="text-slate-300 transition-colors hover:text-white" href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={altHref}
        class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 font-mono text-xs font-semibold text-slate-200 transition hover:border-brand-400/50 hover:text-white"
        aria-label={`Switch language to ${otherLang.toUpperCase()}`}
      >
        {languages[lang]} <span class="text-slate-600">/</span> {languages[otherLang]}
      </a>

      <button
        id="menu-btn"
        type="button"
        class="rounded-lg border border-white/10 bg-white/5 p-2 text-slate-200 transition hover:text-white md:hidden"
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-white/5 bg-ink/95 backdrop-blur-xl md:hidden">
    <ul class="mx-auto flex max-w-5xl flex-col px-4 py-2">
      {
        nav.map((item) => (
          <li>
            <a
              class="block rounded-lg px-3 py-3 text-sm font-medium text-slate-300 transition hover:bg-white/5 hover:text-white"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      })
    );
  }
</script>
