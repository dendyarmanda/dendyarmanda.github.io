---
import { about } from '../data/cv';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="scroll-mt-20 border-t border-white/5 py-16 md:py-24">
  <div data-reveal>
    <p class="font-mono text-sm font-medium text-brand-300">01 · {t('about.kicker')}</p>
    <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white md:text-4xl">
      {t('about.title')}
    </h2>
  </div>

  <p
    data-reveal
    class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-400"
  >
    {about.summary[lang]}
  </p>

  <ul class="mt-8 grid gap-3 sm:grid-cols-2" data-reveal>
    {
      about.focus.map((item) => (
        <li class="glass glass-hover flex items-start gap-3 rounded-xl px-4 py-3.5 text-slate-200">
          <svg
            class="mt-0.5 h-5 w-5 shrink-0 text-brand-300"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
          {item[lang]}
        </li>
      ))
    }
  </ul>
</section>
