---
import { profile } from '../data/cv';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Web3Forms access key. Public by design — it only lets the browser POST a
// message to your inbox; it is not a secret. Regenerate at https://web3forms.com.
const WEB3FORMS_ACCESS_KEY = '6af052a4-73f1-4aaf-bbb9-031e5dc235ba';

const inputClass =
  'mt-1.5 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-white placeholder-slate-500 outline-none transition focus:border-brand-400/60 focus:bg-white/10 focus:ring-2 focus:ring-brand-400/30';
const labelClass = 'block font-mono text-xs font-medium uppercase tracking-wide text-slate-400';
const directLinkClass =
  'group flex min-h-11 items-center gap-3 text-sm text-slate-300 transition hover:text-white';
const directIconClass = 'h-5 w-5 shrink-0 text-brand-300';
---

<section id="contact" class="scroll-mt-20 border-t border-white/5 py-16 md:py-24">
  <div data-reveal>
    <p class="font-mono text-sm font-medium text-brand-300">05 · {t('contact.kicker')}</p>
    <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white md:text-4xl">
      {t('contact.title')}
    </h2>
    <p class="mt-3 text-slate-400">{t('contact.subtitle')}</p>
  </div>

  <div class="mt-8 grid items-start gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
    <form id="contact-form" class="glass space-y-4 rounded-2xl p-6 md:p-8" data-reveal>
      <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
      <input type="hidden" name="subject" value={`Pesan baru dari portfolio ${profile.name}`} />
      <input type="hidden" name="from_name" value="Portfolio Website" />
      <!-- Honeypot anti-spam: must stay empty -->
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label class={labelClass} for="cf-name">{t('contact.name')}</label>
        <input id="cf-name" class={inputClass} type="text" name="name" autocomplete="name" required />
      </div>
      <div>
        <label class={labelClass} for="cf-email">{t('contact.email')}</label>
        <input id="cf-email" class={inputClass} type="email" name="email" autocomplete="email" required />
      </div>
      <div>
        <label class={labelClass} for="cf-message">{t('contact.message')}</label>
        <textarea id="cf-message" class={inputClass} name="message" rows="4" required></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-brand-500 to-brand-300 px-5 py-2.5 text-sm font-semibold text-slate-950 shadow-lg shadow-brand-500/25 transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60"
      >
        {t('contact.send')}
      </button>

      <p id="form-status" role="status" aria-live="polite" class="hidden text-sm font-medium"></p>
    </form>

    <!-- Direct contact: balances the form column on desktop -->
    <aside class="glass rounded-2xl p-6 md:p-8" data-reveal>
      <h3 class="font-mono text-xs font-semibold uppercase tracking-widest text-brand-300">
        {t('contact.direct')}
      </h3>
      <ul class="mt-4 space-y-1">
        <li>
          <a href={`mailto:${profile.email}`} class={directLinkClass}>
            <svg class={directIconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            <span class="break-all">{profile.email}</span>
          </a>
        </li>
        <li>
          <a href={profile.social.github} target="_blank" rel="noopener noreferrer" class={directLinkClass}>
            <svg class={directIconClass} viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.42.36.79 1.08.79 2.18v3.23c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
            GitHub
          </a>
        </li>
        <li>
          <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer" class={directLinkClass}>
            <svg class={directIconClass} viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            LinkedIn
          </a>
        </li>
        <li>
          <p class="flex min-h-11 items-center gap-3 text-sm text-slate-300">
            <svg class={directIconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
            {profile.location[lang]}
          </p>
        </li>
      </ul>
    </aside>
  </div>
</section>

<script
  is:inline
  define:vars={{
    sending: t('contact.sending'),
    success: t('contact.success'),
    error: t('contact.error'),
    sendLabel: t('contact.send'),
  }}
>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    const originalLabel = button.textContent;
    button.disabled = true;
    button.textContent = sending;
    status.classList.add('hidden');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const result = await response.json();
      status.classList.remove('hidden');
      if (result.success) {
        status.textContent = success;
        status.style.color = '#34d399';
        form.reset();
      } else {
        status.textContent = error;
        status.style.color = '#f87171';
      }
    } catch {
      status.classList.remove('hidden');
      status.textContent = error;
      status.style.color = '#f87171';
    } finally {
      button.disabled = false;
      button.textContent = originalLabel || sendLabel;
    }
  });
</script>
