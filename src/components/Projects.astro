---
import { projects } from '../data/cv';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const oddCount = projects.length % 2 === 1;
---

<section id="projects" class="scroll-mt-20 border-t border-white/5 py-16 md:py-24">
  <div data-reveal>
    <p class="font-mono text-sm font-medium text-brand-300">04 · {t('projects.kicker')}</p>
    <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white md:text-4xl">
      {t('projects.title')}
    </h2>
  </div>

  <div class="mt-10 grid gap-5 sm:grid-cols-2">
    {
      projects.map((project, i) => (
        <article
          data-reveal
          class:list={[
            'glass glass-hover spotlight group relative flex flex-col overflow-hidden rounded-2xl p-6',
            // no orphan hole: last card of an odd list spans the full row
            oddCount && i === projects.length - 1 && 'sm:col-span-2',
          ]}
        >
          <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-400/60 to-transparent" />
          <h3 class="font-display text-lg font-semibold text-white">{project.name}</h3>
          {project.period && (
            <p class="mt-1 font-mono text-xs text-slate-500">{project.period[lang]}</p>
          )}
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
            {project.description[lang]}
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <li class="rounded-md bg-brand-400/10 px-2 py-0.5 font-mono text-xs font-medium text-brand-200 ring-1 ring-inset ring-brand-400/20">
                {tech}
              </li>
            ))}
          </ul>
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-300 transition after:absolute after:inset-0 hover:text-brand-200"
            >
              {t('projects.visit')}
              <svg
                aria-hidden="true"
                class="h-4 w-4 transition group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>

<script>
  // Spotlight: track cursor per card via CSS vars (style in global.css)
  document.querySelectorAll<HTMLElement>('.spotlight').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--sx', `${e.clientX - r.left}px`);
      card.style.setProperty('--sy', `${e.clientY - r.top}px`);
    });
  });
</script>
