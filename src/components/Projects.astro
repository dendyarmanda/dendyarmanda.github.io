---
import { projects } from '../data/cv';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="projects"
  class="border-t border-slate-200 py-12 md:py-16 dark:border-slate-800"
>
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
    {t('projects.title')}
  </h2>

  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {
      projects.map((project) => (
        <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 transition hover:border-brand-400 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-500">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
            {project.name}
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            {project.description[lang]}
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <li class="rounded bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">
                {tech}
              </li>
            ))}
          </ul>
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400"
            >
              {t('projects.visit')}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
