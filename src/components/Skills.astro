---
import { skills } from '../data/cv';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="skills" class="scroll-mt-20 border-t border-white/5 py-16 md:py-24">
  <div data-reveal>
    <p class="font-mono text-sm font-medium text-brand-300">03 · {t('skills.kicker')}</p>
    <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white md:text-4xl">
      {t('skills.title')}
    </h2>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      skills.map((group) => (
        <div data-reveal class="glass glass-hover rounded-2xl p-6">
          <h3 class="font-mono text-xs font-semibold uppercase tracking-widest text-brand-300">
            {group.title[lang]}
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-medium text-slate-200 transition hover:border-brand-400/40 hover:text-white">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
