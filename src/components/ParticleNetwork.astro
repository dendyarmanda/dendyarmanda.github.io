---
// Lightweight interactive particle network background (vanilla canvas, no deps).
// Fixed full-viewport, behind all content, pointer-events: none.
---

<canvas
  id="bg-particles"
  class="no-print pointer-events-none fixed inset-0 -z-10 h-full w-full"
  aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('bg-particles') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COLOR = '56,189,248'; // brand cyan (rgb)
    const LINK = 130; // px: link two particles
    const MOUSE_LINK = 170; // px: link particle to cursor

    let w = 0,
      h = 0,
      dpr = 1,
      raf = 0;
    let particles: { x: number; y: number; vx: number; vy: number }[] = [];
    const mouse = { x: -9999, y: -9999 };

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function build() {
      // scale count to viewport; cap for performance
      const count = Math.min(Math.floor(w / 16), 90);
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
      }));
    }

    function draw(animate: boolean) {
      ctx!.clearRect(0, 0, w, h);

      for (const p of particles) {
        if (animate) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x <= 0 || p.x >= w) p.vx *= -1;
          if (p.y <= 0 || p.y >= h) p.vy *= -1;
          // gentle pull toward cursor when near (the "interactive" feel)
          const mdx = mouse.x - p.x;
          const mdy = mouse.y - p.y;
          const md = Math.hypot(mdx, mdy);
          if (md < MOUSE_LINK) {
            const f = (1 - md / MOUSE_LINK) * 0.02;
            p.x += mdx * f;
            p.y += mdy * f;
          }
        }
      }

      // links between particles
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d < LINK) {
            ctx!.strokeStyle = `rgba(${COLOR},${0.13 * (1 - d / LINK)})`;
            ctx!.lineWidth = 1;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.stroke();
          }
        }
        // link to cursor
        const mdx = a.x - mouse.x;
        const mdy = a.y - mouse.y;
        const md = Math.hypot(mdx, mdy);
        if (md < MOUSE_LINK) {
          ctx!.strokeStyle = `rgba(${COLOR},${0.33 * (1 - md / MOUSE_LINK)})`;
          ctx!.lineWidth = 1;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(mouse.x, mouse.y);
          ctx!.stroke();
        }
      }

      // dots
      ctx!.fillStyle = `rgba(${COLOR},0.55)`;
      for (const p of particles) {
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
        ctx!.fill();
      }

      if (animate) raf = requestAnimationFrame(() => draw(true));
    }

    function start() {
      cancelAnimationFrame(raf);
      resize();
      build();
      draw(!reduce); // reduced-motion → one static frame
    }

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });
    window.addEventListener('mouseout', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    let rt = 0;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(start, 200);
    });

    // pause when tab hidden (battery)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
      } else if (!reduce) {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => draw(true));
      }
    });

    start();
  }
</script>
