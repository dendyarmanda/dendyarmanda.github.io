---
import { experience } from '../data/cv';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="scroll-mt-20 border-t border-white/5 py-16 md:py-24">
  <div data-reveal>
    <p class="font-mono text-sm font-medium text-brand-300">02 · {t('experience.kicker')}</p>
    <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white md:text-4xl">
      {t('experience.title')}
    </h2>
  </div>

  <div class="mt-10 space-y-6">
    {
      experience.map((job) => (
        <article
          data-reveal
          class="glass glass-hover relative rounded-2xl p-6 pl-8"
        >
          <span class="absolute left-0 top-7 h-[calc(100%-3.5rem)] w-px bg-gradient-to-b from-brand-400 to-transparent" />
          <span class="absolute -left-[5px] top-7 h-2.5 w-2.5 rounded-full bg-brand-400 shadow-[0_0_12px_2px_rgba(56,189,248,0.6)]" />
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-display text-lg font-semibold text-white">
              {job.role[lang]}
              <span class="font-sans font-normal text-slate-400"> · {job.company}</span>
            </h3>
            <p class="font-mono text-xs text-brand-200">{job.period[lang]}</p>
          </div>
          <ul class="mt-3 space-y-2 text-slate-400">
            {job.highlights.map((h) => (
              <li class="flex gap-2.5">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brand-400" />
                {h[lang]}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
