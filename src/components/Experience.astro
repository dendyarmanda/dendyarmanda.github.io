---
import { experience } from '../data/cv';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../data/cv';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="experience"
  class="border-t border-slate-200 py-12 md:py-16 dark:border-slate-800"
>
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
    {t('experience.title')}
  </h2>

  <div class="mt-8 space-y-8">
    {
      experience.map((job) => (
        <article class="relative border-l-2 border-slate-200 pl-6 dark:border-slate-700">
          <span class="absolute -left-[7px] top-1.5 h-3 w-3 rounded-full bg-brand-600 dark:bg-brand-400" />
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
              {job.role[lang]}
              <span class="font-normal text-slate-500 dark:text-slate-400">
                · {job.company}
              </span>
            </h3>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">
              {job.period[lang]}
            </p>
          </div>
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-slate-600 marker:text-brand-500 dark:text-slate-300">
            {job.highlights.map((h) => (
              <li>{h[lang]}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
