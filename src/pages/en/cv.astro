---
import Base from '../../layouts/Base.astro';
import Resume from '../../components/Resume.astro';
import { profile } from '../../data/cv';
import { useTranslations } from '../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
const title = `${profile.name} — CV`;
---

<Base
  lang={lang}
  title={title}
  description={profile.tagline.en}
  altHref="/cv"
  showChrome={false}
>
  <div
    class="no-print sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-slate-50/90 px-4 py-3 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90"
  >
    <a
      href="/en/"
      class="text-sm font-medium text-slate-600 hover:text-brand-600 dark:text-slate-300"
      >{t('cv.back')}</a
    >
    <button
      id="print-btn"
      type="button"
      class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700"
    >
      {t('cv.download')}
    </button>
  </div>

  <Resume lang={lang} />
</Base>

<script>
  document
    .getElementById('print-btn')
    ?.addEventListener('click', () => window.print());
</script>
