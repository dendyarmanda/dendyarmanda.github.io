---
import Base from '../layouts/Base.astro';
import Resume from '../components/Resume.astro';
import { profile } from '../data/cv';
import { useTranslations } from '../i18n/ui';

const lang = 'id';
const t = useTranslations(lang);
const title = `${profile.name} — CV`;
---

<Base
  lang={lang}
  title={title}
  description={profile.tagline.id}
  altHref="/en/cv"
  showChrome={false}
>
  <div
    class="no-print sticky top-0 z-10 flex items-center justify-between border-b border-white/5 bg-ink/80 px-4 py-3 backdrop-blur-xl"
  >
    <a
      href="/"
      class="text-sm font-medium text-slate-300 transition hover:text-white"
      >{t('cv.back')}</a
    >
    <button
      id="print-btn"
      type="button"
      class="rounded-xl bg-gradient-to-r from-brand-500 to-brand-300 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:brightness-110"
    >
      {t('cv.download')}
    </button>
  </div>

  <Resume lang={lang} />
</Base>

<script>
  document
    .getElementById('print-btn')
    ?.addEventListener('click', () => window.print());
</script>
